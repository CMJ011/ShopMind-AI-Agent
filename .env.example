# ==========================================
# ShopMind AI Agent 环境变量配置模板
# 使用方法：将此文件复制一份，重命名为 .env，然后填入你自己的真实数据
# ==========================================

# 1. 模型运行模式
# 可选值: mock (本地模拟，不需要联网和API Key) 或 live (真实调用大模型)
LLM_MODE=mock

# 2. 大模型 API 配置（以 DeepSeek 为例，完全兼容 OpenAI 格式）
# 如果你使用 OpenAI 官方，请改为 https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 3. 你的真实 API Key
# 请将下面的占位符替换为你自己的 Key，注意不要泄露给他人
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. 使用的模型名称
# DeepSeek 填 deepseek-chat，OpenAI 填 gpt-3.5-turbo 或 gpt-4o
LLM_MODEL=deepseek-chat